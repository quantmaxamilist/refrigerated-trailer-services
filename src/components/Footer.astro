---
import Icon from './Icon.astro';
import { brand, contact, google, social, nav, makes, C } from '../data/site';
import { oldCities, cityPath } from '../data/areas';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="top">
      <a href="/" class="flogo" aria-label={`${brand.legal} home`}><img src="/img/brand/rts-logo-light.png" width="576" height="180" alt={brand.legal} loading="lazy" /></a>
      <div class="calls">
        <a href={contact.phoneHref}><Icon name="phone" />{contact.phone}</a>
        <a href={contact.mobileHref}><Icon name="phone" />{contact.mobile}</a>
        <a href={contact.whatsapp}><Icon name="wa" />WhatsApp</a>
        <a class="mail" href={`mailto:${contact.email}`}><Icon name="mail" /><span>{contact.email.split('@')[0]}@<wbr />{contact.email.split('@')[1]}</span></a>
      </div>
    </div>
    <div class="cols">
      <div>
        <h2>Get in Touch</h2>
        <address>{brand.legal}<br />{contact.address.map((l) => <>{l}<br /></>)}</address>
        <p><a class="link" href={`https://w3w.co/${contact.w3w}`} rel="noopener">What3Words /// {contact.w3w}</a></p>
        <p><a class="link" href={google.directions} rel="noopener">Get Directions</a></p>
      </div>
      <div>
        <h2>Opening Hours</h2>
        <dl class="hours">{C.shared.hours.map(([d, h]) => <><dt>{d}</dt><dd>{h}</dd></>)}</dl>
      </div>
      <div>
        <h2>Trailers</h2>
        <ul>
          <li><a href="/showroom">Showroom</a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          {makes.map((m) => <li><a href={`/used-trailers/${m.slug}`}>{m.name} Trailers</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Areas</h2>
        <ul>
          {oldCities.map((c) => <li><a href={cityPath(c)}>Refrigerated Trucks for Sale in {c}</a></li>)}
          <li><a href="/areas">South Wales and all areas</a></li>
        </ul>
      </div>
    </div>
    <div class="base">
      <p class="legalline"><span>© {year} {brand.legal}</span><span>Company Registration Number {brand.companyNo}</span></p>
      <ul>
        <li><a href="/reviews">Reviews</a></li>
        <li><a href={social.facebook} rel="noopener">Facebook</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/sitemap">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--stage); color: rgba(255, 255, 255, 0.74); padding: clamp(56px, 7vw, 96px) 0 28px; font-size: var(--fs-small); }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; padding-bottom: 36px; border-bottom: 1px solid var(--line-d); }
  .flogo img { height: 64px; width: auto; }
  .calls { display: flex; flex-wrap: wrap; gap: 10px 26px; }
  .calls a { display: inline-flex; align-items: center; gap: 9px; color: #fff; font: 700 1rem/1.2 var(--f-mono); min-width: 0; overflow-wrap: anywhere; }
  .calls a :global(svg) { flex: none; }
  .calls a:hover { color: var(--cyan); }
  .cols { display: grid; grid-template-columns: 1.15fr 0.9fr 1fr 1.25fr; gap: 36px clamp(24px, 4vw, 64px); padding: 44px 0; }
  h2 { font-size: 1rem; color: #fff; margin-bottom: 16px; letter-spacing: -0.01em; }
  address { font-style: normal; line-height: 1.7; margin-bottom: 14px; }
  .cols p + p { margin-top: 8px; }
  .cols ul { display: grid; gap: 7px; }
  .cols a:hover { color: #fff; }
  .cols :global(.link) { color: var(--cyan); }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; font-family: var(--f-mono); font-size: 0.875rem; }
  .hours dt { color: rgba(255, 255, 255, 0.6); }
  .hours dd { color: #fff; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px 30px; padding-top: 24px; border-top: 1px solid var(--line-d); font-size: var(--fs-tiny); }
  .legalline { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .base ul { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .base a:hover { color: #fff; }
  @media (max-width: 980px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .ftr { padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)); } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } .calls { display: grid; } .calls a { font-size: 0.875rem; } .calls .mail { font: 700 0.875rem/1.3 var(--f-body); } }
  @media (max-width: 360px) { .calls .mail { font-size: 0.8125rem; } }
</style>
