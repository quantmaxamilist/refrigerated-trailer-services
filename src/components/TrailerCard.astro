---
import type { Trailer } from '../data/stock';
import { niceTitle } from '../data/stock';
interface Props { t: Trailer; eager?: boolean }
const { t, eager = false } = Astro.props;
---
<article class="tc" data-card data-make={t.makeSlug} data-new={t.isNew ? '1' : '0'} data-temp={t.temp} data-year={t.year}>
  <a class="ph" href={t.path} tabindex="-1" aria-hidden="true">
    <img src={`/stock/${t.id}/card.webp`} width="720" height="540" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class:list={['flag', { isnew: t.isNew }]}>{t.isNew ? 'New' : 'Used'}</span>
    <span class="count mono">{t.photos.length} {t.photos.length === 1 ? 'photo' : 'photos'}</span>
  </a>
  <div class="bd">
    <div class="row"><span class="plate"><span>{t.ref}</span></span><span class="price">{t.price}</span></div>
    <h3 class="h-4"><a href={t.path}>{niceTitle(t)}</a></h3>
    <p class="sum">{t.summary}</p>
    <dl class="facts">
      {t.fridge && <div class="wide"><dt>Fridge</dt><dd>{t.fridge}</dd></div>}
      {t.hours && <div><dt>Hours</dt><dd>{t.hours}</dd></div>}
      {t.mot && <div><dt>MOT</dt><dd>{t.mot}</dd></div>}
      {t.tyres && <div><dt>Tyres</dt><dd>{t.tyres}</dd></div>}
      {t.axles && <div><dt>Axles</dt><dd>{t.axles}</dd></div>}
    </dl>
    <div class="acts"><a class="btn btn--sm" href={t.path}>View details</a><a class="btn btn--sm btn--ghost" href={`/enquiry?trailer=${t.id}`}>Enquire</a></div>
  </div>
</article>

<style>
  .tc { display: grid; grid-template-rows: auto 1fr; background: var(--paper); border-radius: var(--r); overflow: hidden; box-shadow: 0 0 0 1px var(--line); transition: box-shadow 0.25s, transform 0.25s var(--ease); }
  .tc:hover { box-shadow: 0 0 0 2px var(--navy), 0 18px 40px -22px rgba(12, 18, 48, 0.5); transform: translateY(-3px); }
  .ph { position: relative; display: block; aspect-ratio: 4 / 3; background: var(--ice); overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .tc:hover .ph img { transform: scale(1.04); }
  .flag { position: absolute; left: 0; top: 14px; background: var(--paper); color: var(--ink); font: italic 800 0.8125rem/1 var(--f-display); padding: 7px 14px 6px 12px; border-radius: 0 3px 3px 0; }
  .flag.isnew { background: var(--cyan); color: var(--stage); }
  .count { position: absolute; right: 10px; bottom: 10px; background: rgba(9, 14, 43, 0.78); color: #fff; padding: 4px 8px; border-radius: 3px; }
  .bd { display: grid; gap: 12px; padding: 18px 18px 20px; align-content: start; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .price { font: 800 1rem/1 var(--f-display); color: var(--navy); }
  h3 a:hover { color: var(--navy); }
  .sum { font-size: var(--fs-small); color: var(--mute); line-height: 1.45; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; border-top: 1px solid var(--line); }
  .facts > div { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); min-width: 0; }
  .facts > .wide { grid-column: 1 / -1; }
  .facts dt { font-size: var(--fs-tiny); color: var(--mute); white-space: nowrap; }
  .facts dd { font: 600 0.8125rem/1.5 var(--f-mono); color: var(--ink); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acts { display: flex; gap: 10px; margin-top: 4px; }
  .acts .btn { flex: 1; }
</style>
