---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StockList from '../components/StockList.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { C } from '../data/site';
import { newStock } from '../data/stock';
const N = C.newTrailers;
const crumbs = [{ name: 'New Lamberet Trailers', path: '/new-trailers' }];
---
<Base title={N.title} desc={N.desc} crumbs={crumbs}>
  <PageHero title={N.h1} lede={C.home.lamberet[0]} img="yard-pair" crumbs={crumbs} />
  <section class="sec"><div class="wrap"><StockList items={newStock} filters={false} /></div></section>
  <section class="sec sec--ice">
    <div class="wrap">
      <div class="linehead" data-reveal><h2 class="h-2">{N.distH}</h2></div>
      <div class="grid-2">
        <div class="prose" data-reveal>
          <p class="lede">{N.dist}</p>
          <figure class="photo"><img src="/img/lamberet-sr2.webp" width="800" height="600" alt="Lamberet SR2 HD heavy duty refrigerated trailer" loading="lazy" /></figure>
        </div>
        <div class="lists" data-reveal="0.08">
          <div><h3 class="h-3">{N.whyH.replace(/:$/, '')}</h3><ul class="ticks">{N.why.map((x) => <li>{x}</li>)}</ul></div>
          <div><h3 class="h-3">{N.offersH.replace(/:$/, '')}</h3><ul class="ticks">{N.offers.map((x) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </div>
  </section>
  <EnquiryBand package="new lamberet trailers" />
</Base>
<style>
  .lists { display: grid; gap: 40px; }
  .lists h3 { margin-bottom: 18px; }
  .photo { margin-top: 28px; background: #fff; }
</style>
