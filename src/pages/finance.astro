---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { C } from '../data/site';
const F = C.finance; const crumbs = [{ name: 'Finance', path: '/finance' }];
const fix = (s: string) => s.replace('owner?operators', 'owner-operators');
---
<Base title={F.title} desc={fix(F.desc)} crumbs={crumbs}>
  <PageHero title={F.h1} lede={F.partner[0]} img="customer-truck" crumbs={crumbs} />
  <section class="sec">
    <div class="wrap grid-2">
      <div data-reveal>
        <div class="linehead"><h2 class="h-3">{F.buyH}</h2></div>
        <p class="lede">{F.buyIntro}</p>
        <ul class="ticks buy">{F.buyList.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="prose" data-reveal="0.08">
        <h2 class="h-3">{F.partnerH}</h2>
        {F.partner.slice(1).map((p) => <p>{p}</p>)}
        <div class="btns"><a class="btn" href="/contact?package=finance">Contact Us</a></div>
      </div>
    </div>
  </section>
  <section class="sec sec--ice">
    <div class="wrap cols-3">
      <div class="pt" data-reveal><h2 class="h-3">{F.hpH}</h2>{F.hp.map((p) => <p>{p}</p>)}<ul class="ticks">{F.hpList.map((x) => <li>{x}</li>)}</ul></div>
      <div class="pt" data-reveal="0.05"><h2 class="h-3">{F.flH}</h2>{F.fl.map((p) => <p>{p}</p>)}<ul class="ticks">{F.flList.map((x) => <li>{x}</li>)}</ul></div>
      <div class="pt" data-reveal="0.1"><h2 class="h-3">{F.slbH}</h2>{F.slb.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>
  <EnquiryBand title={F.h1} sub={F.cta} package="finance" />
</Base>
<style>.buy { margin-top: 22px; }</style>
