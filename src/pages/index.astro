---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TrailerCard from '../components/TrailerCard.astro';
import Fleet from '../components/Fleet.astro';
import Reviews from '../components/Reviews.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { C, contact, services, brandsStocked, brandFile, makes } from '../data/site';
import { stock, newStock, usedStock } from '../data/stock';
const featured = stock.slice(0, 10);
const facts = [
  { n: '2008', t: C.home.about[0].split(',')[0] + '.' },
  { n: '300', t: C.home.intro[1] },
  { n: '500', t: C.about.offer[5] },
  { n: '4', t: C.about.languages },
];
const makeOf = (b: string) => makes.find((m) => m.name === b);
---
<Base title={C.home.title} desc={C.home.desc} flush>
  <section class="hero">
    <video class="bgv" muted loop playsinline preload="none" poster="/video/line-poster.webp" data-hero data-sm="/video/line-720.mp4" data-lg="/video/line-1080.mp4" aria-hidden="true"></video>
    <div class="wrap hero-in">
      <div class="lead">
        <h1 class="h-hero">Refrigerated trailers for sale</h1>
        <p class="lede">{C.home.intro[0]} {C.home.intro[2]}</p>
        <div class="btns">
          <a class="btn btn--cyan" href="/showroom">View Our Showroom</a>
          <a class="btn btn--ghost-d" href="/sell-your-trailer">Sell Your Trailer</a>
        </div>
        <a class="call" href={contact.phoneHref}><Icon name="phone" size={18} />{contact.phone}</a>
      </div>
      <a class="tally" href="/showroom">
        <span class="n">{stock.length}</span>
        <span class="t">trailers in the showroom today</span>
        <span class="rows mono"><span>{newStock.length} new Lamberet</span><span>{usedStock.length} used</span></span>
      </a>
    </div>
  </section>

  <section class="brands" aria-label="Makes we buy and sell">
    <div class="wrap">
      <p class="bl">{C.exporting.services[4][1]}</p>
      <ul>
        {brandsStocked.map((b) => {
          const m = makeOf(b);
          const img = <img src={`/img/brands/${brandFile[b]}.png`} width="200" height="159" alt={b} loading="lazy" />;
          return <li>{m ? <a href={`/used-trailers/${m.slug}`} title={`${b} Trailers`}>{img}</a> : img}</li>;
        })}
      </ul>
    </div>
  </section>

  <section class="sec feat">
    <div class="wrap">
      <div class="linehead" data-reveal><h2 class="h-2">Featured Trailers</h2></div>
    </div>
    <div class="strip" data-strip tabindex="0" aria-label="Featured trailers, scroll sideways">
      {featured.map((t, i) => <TrailerCard t={t} eager={i < 2} />)}
      <a class="more" href="/showroom"><span class="h-3">All {stock.length} trailers</span><span class="btn btn--cyan">View Our Showroom</span></a>
    </div>
    <div class="wrap stripnav">
      <button type="button" data-strip-prev aria-label="Previous trailers"><Icon name="prev" /></button>
      <button type="button" data-strip-next aria-label="More trailers"><Icon name="next" /></button>
      <a class="link" href="/used-trailers">Used Trailers</a>
      <a class="link" href="/new-trailers">New Trailers</a>
    </div>
  </section>

  <Fleet />

  <section class="sec lam">
    <div class="wrap grid-2 grid-2--mid">
      <figure class="photo" data-reveal>
        <img src="/img/yard-pair.webp" srcset="/img/yard-pair-960.webp 960w, /img/yard-pair.webp 1600w" sizes="(max-width: 900px) 100vw, 50vw" width="1600" height="900" alt="Two new Lamberet refrigerated trailers at Refrigerated Trailer Services" loading="lazy" />
      </figure>
      <div class="prose" data-reveal="0.08">
        <h2 class="h-2">{C.home.lamberetH}</h2>
        {C.home.lamberet.map((p) => <p>{p}</p>)}
        <div class="btns">
          <a class="btn" href="/new-trailers">New Lamberet Trailers</a>
          <span class="plate plate--line"><span>{newStock.length} new in stock</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--ice svc">
    <div class="wrap">
      <div class="linehead" data-reveal><h2 class="h-2">{C.home.oneStopH}</h2></div>
      <div class="svc-grid">
        <div>
          <div class="prose intro" data-reveal>{C.home.oneStop.slice(0, 4).map((p) => <p>{p}</p>)}</div>
          <ul class="rows" data-rows>
            {services.map((s, i) => (
              <li data-row={i}>
                <a href={s.href}>
                  <span class="rt h-3">{s.title}</span>
                  <span class="rl">{s.line}</span>
                  <span class="ri"><Icon name="go" size={22} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="sticky" aria-hidden="true">
          {services.map((s, i) => <img src={`/img/${s.img}${s.img.match(/^(carrier-yard|customer-truck|fridge-units)$/) ? '' : '-960'}.webp`} alt="" loading="lazy" class:list={{ on: i === 0 }} data-shot={i} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="about">
    <img class="abg" src="/img/aerial-rows.webp" srcset="/img/aerial-rows-960.webp 960w, /img/aerial-rows.webp 1920w" sizes="100vw" width="1920" height="978" alt="" loading="lazy" />
    <div class="wrap about-in">
      <div class="prose" data-reveal>
        <h2 class="h-2">{C.home.aboutH}</h2>
        {C.home.about.map((p) => <p>{p}</p>)}
        <a class="btn btn--ghost-d" href="/about">About Us</a>
      </div>
      <dl class="facts">
        {facts.map((f, i) => <div data-reveal={String(0.05 * i)}><dt>{f.n}</dt><dd>{f.t}</dd></div>)}
      </dl>
    </div>
  </section>

  <Reviews />
  <EnquiryBand />
</Base>

<script>
  // hero film: pick the right size, never autoplay for reduced motion or data saver
  const v = document.querySelector<HTMLVideoElement>('[data-hero]');
  if (v) {
    const saver = (navigator as any).connection?.saveData;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !saver) {
      v.src = innerWidth < 900 ? v.dataset.sm! : v.dataset.lg!;
      v.play().catch(() => {});
      new IntersectionObserver((es) => { es[0].isIntersecting ? v.play().catch(() => {}) : v.pause(); }).observe(v);
    }
  }
  // featured strip arrows
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  if (strip) {
    const step = () => Math.max(320, strip.clientWidth * 0.8);
    document.querySelector('[data-strip-prev]')?.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('[data-strip-next]')?.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: 'smooth' }));
  }
  // services: the row crossing the middle of the screen picks the photo; rows never change size
  const rows = document.querySelectorAll<HTMLElement>('[data-row]');
  const shots = document.querySelectorAll<HTMLElement>('[data-shot]');
  if (rows.length && shots.length) {
    const pick = (i: string) => { rows.forEach((r) => r.classList.toggle('on', r.dataset.row === i)); shots.forEach((s) => s.classList.toggle('on', s.dataset.shot === i)); };
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && pick((e.target as HTMLElement).dataset.row!)), { rootMargin: '-48% 0px -48% 0px' });
    rows.forEach((r) => { io.observe(r); r.addEventListener('mouseenter', () => pick(r.dataset.row!)); });
  }
</script>

<style>
  /* hero */
  .hero { position: relative; min-height: max(640px, 100svh); display: grid; align-items: end; isolation: isolate; background: var(--stage) url('/video/line-poster-960.webp') center / cover no-repeat; color: #fff; overflow: hidden; }
  .bgv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(9, 14, 43, 0.9) 0%, rgba(9, 14, 43, 0.62) 38%, rgba(9, 14, 43, 0.08) 72%), linear-gradient(0deg, rgba(9, 14, 43, 0.72) 0%, rgba(9, 14, 43, 0) 40%); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; padding-top: calc(var(--hdr) + 48px); padding-bottom: clamp(36px, 5vw, 72px); }
  .lead { display: grid; gap: 22px; max-width: 46rem; }
  .lead h1 { color: #fff; max-width: 11ch; }
  .lead .lede { color: rgba(255, 255, 255, 0.9); max-width: 44ch; }
  .call { display: inline-flex; align-items: center; gap: 10px; font: 700 1.0625rem/1 var(--f-mono); color: #fff; justify-self: start; }
  .call:hover { color: var(--cyan); }
  .tally { display: grid; gap: 6px; padding: 20px 22px; min-width: 232px; background: rgba(9, 14, 43, 0.72); border-left: 4px solid var(--cyan); border-radius: 0 var(--r) var(--r) 0; transition: background-color 0.2s; }
  .tally:hover { background: rgba(9, 14, 43, 0.9); }
  .tally .n { font: 900 clamp(3rem, 2rem + 3vw, 4.75rem)/0.9 var(--f-display); letter-spacing: -0.04em; color: #fff; }
  .tally .t { font-weight: 700; color: #fff; }
  .tally .rows { display: flex; gap: 14px; color: var(--cyan); margin-top: 4px; }
  @media (max-width: 860px) {
    .hero-in { grid-template-columns: minmax(0, 1fr); }
    .tally { grid-template-columns: auto 1fr; align-items: center; column-gap: 16px; min-width: 0; }
    .tally .n { grid-row: span 2; font-size: 3rem; }
    .hero::before { background: linear-gradient(0deg, rgba(9, 14, 43, 0.94) 0%, rgba(9, 14, 43, 0.74) 52%, rgba(9, 14, 43, 0.3) 100%); }
  }

  /* makes */
  .brands { background: var(--paper); border-bottom: 1px solid var(--line); padding: 26px 0 22px; }
  .brands .wrap { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 20px 40px; align-items: center; }
  .bl { font-size: var(--fs-small); color: var(--mute); line-height: 1.45; }
  .brands ul { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 6px; align-items: center; }
  .brands img { width: 100%; max-width: 104px; margin: 0 auto; mix-blend-mode: multiply; filter: grayscale(1) contrast(1.05); opacity: 0.72; transition: filter 0.25s, opacity 0.25s; }
  .brands li:hover img { filter: none; opacity: 1; }
  @media (max-width: 900px) { .brands .wrap { grid-template-columns: minmax(0, 1fr); } .brands ul { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .brands ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* featured strip, parked on the line */
  .feat { padding-bottom: clamp(48px, 6vw, 96px); overflow: hidden; }
  .strip { --edge: max(var(--gut), calc((100vw - var(--wrap)) / 2 + var(--gut))); display: grid; grid-auto-flow: column; grid-auto-columns: min(84vw, 372px); gap: clamp(16px, 1.8vw, 26px); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: var(--edge); padding: 4px var(--edge) 26px; scrollbar-width: none; background: linear-gradient(var(--cyan), var(--cyan)) 0 calc(100% - 10px) / 100% 3px no-repeat; }
  .strip::-webkit-scrollbar { display: none; }
  .strip > :global(*) { scroll-snap-align: start; }
  .more { display: grid; align-content: center; justify-items: start; gap: 18px; padding: 28px; background: var(--stage); border-radius: var(--r); }
  .more .h-3 { color: #fff; }
  .stripnav { display: flex; align-items: center; gap: 12px; margin-top: 22px; }
  .stripnav button { width: 48px; height: 48px; border: 0; border-radius: var(--r); background: var(--ice); color: var(--ink); display: grid; place-items: center; transition: background-color 0.2s, color 0.2s; }
  .stripnav button:hover { background: var(--navy); color: #fff; }
  .stripnav .link { margin-left: 14px; }
  @media (hover: none) { .stripnav button { display: none; } .stripnav .link:first-of-type { margin-left: 0; } }

  /* Lamberet */
  .lam .photo { aspect-ratio: 16 / 10; }
  .lam .btns { align-items: center; margin-top: 1.6em; }

  /* services list with a photo that follows */
  .svc-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 88px); align-items: start; }
  .intro { margin-bottom: 36px; }
  .rows { border-top: 2px solid var(--ink); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 20px; row-gap: 6px; align-items: center; padding: 20px 0; min-height: 116px; align-content: center; }
  .rt { grid-column: 1; font-family: var(--f-display); font-weight: 800; color: var(--ink); transition: color 0.2s; }
  .rl { grid-column: 1; font-size: var(--fs-small); color: var(--mute); line-height: 1.45; max-width: 58ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ri { grid-column: 2; grid-row: 1 / span 2; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; color: var(--navy); box-shadow: inset 0 0 0 2px var(--line); transition: background-color 0.2s, color 0.2s, box-shadow 0.2s; }
  .rows li.on .rt, .rows a:hover .rt { color: var(--navy); }
  .rows li.on .ri, .rows a:hover .ri { background: var(--cyan); color: var(--stage); box-shadow: none; }
  .sticky { position: sticky; top: calc(var(--hdr) + 28px); aspect-ratio: 4 / 5; border-radius: var(--r); overflow: hidden; background: var(--stage); }
  .sticky img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s var(--ease); }
  .sticky img.on { opacity: 1; }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: minmax(0, 1fr); } .sticky { display: none; } .rows a { min-height: 0; } }

  /* about band */
  .about { position: relative; isolation: isolate; color: rgba(255, 255, 255, 0.86); overflow: hidden; }
  .abg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .about::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(9, 14, 43, 0.95) 0%, rgba(9, 14, 43, 0.84) 46%, rgba(9, 14, 43, 0.5) 100%); }
  .about-in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 104px); padding-top: var(--sec); padding-bottom: var(--sec); align-items: center; }
  .about h2 { color: #fff; }
  .about .btn { margin-top: 1.6em; }
  .facts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px clamp(20px, 3vw, 44px); }
  .facts dt { font: 900 var(--fs-display-1)/0.86 var(--f-display); letter-spacing: -0.045em; color: #fff; border-bottom: 3px solid var(--cyan); padding-bottom: 12px; margin-bottom: 12px; font-size: clamp(3rem, 1.6rem + 4.2vw, 5.75rem); }
  .facts dd { font-size: var(--fs-small); line-height: 1.45; color: rgba(255, 255, 255, 0.82); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 900px) { .about-in { grid-template-columns: minmax(0, 1fr); } }
</style>
