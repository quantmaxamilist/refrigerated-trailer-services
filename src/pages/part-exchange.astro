---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { C, contact, brand } from '../data/site';
const crumbs = [{ name: 'Part Exchange', path: '/part-exchange' }];
---
<Base title={`${C.partExchange.h1} | ${brand.legal}`} desc={`${C.partExchange.h1} for ${brand.legal}. ${C.home.intro[0]} Call ${contact.phone}.`} crumbs={crumbs}>
  <PageHero title={C.partExchange.h1} crumbs={crumbs} />
  <section class="sec">
    <div class="wrap narrow"><div class="card"><EnquiryForm mode="px" /></div>
      <p class="alt">Or call <a class="link" href={contact.phoneHref}>{contact.phone}</a> or <a class="link" href={contact.mobileHref}>{contact.mobile}</a>.</p>
    </div>
  </section>
</Base>
<style>.alt { margin-top: 22px; font-weight: 700; }</style>
